ss","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["","","","xl_sft",300,"auto","bf16",""]},{"id":9,"type":"Note","pos":[12.214884817279541,-537.7766824606144],"size":[1036.5538687500007,380.9777875],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"🎓 NOVA ACE 1.5 LORA - SETUP ORDER (START HERE)","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["1. Used tagged audio files: must contain comments, description, title and lyrics.\n\n2. Set folders in the Folder Locations node. * change path separator for operating system.\n\n3. Set file filter and limit in batch audio node. ** limit 0 = no limit.\n\n4. Set the trigger word in Nova ACE Dataset Builder. This is the token you type\n   at generation time to invoke the LoRA - without it the LoRA has no trigger.\n\n5. Set Ace-Step variant and max duration of audio file in nova ace preprocess node.\n\n6. *** Run NOVA ACE SETUP CHECK below to verify if preprocess or training would run ***\n\n7. Set the SAME Ace-Step variant in the trainer as in step 5. ** Set dry_run for test run.\n\n   Variants: xl_sft / xl_turbo / xl_base (9.3 GB) or sft / turbo / base (4.5 GB).\n   The variant must match across Preprocess, Trainer and Setup Check - the\n   tensors are encoded against one specific model and are not portable."],"color":"#432","bgcolor":"#653"},{"id":7,"type":"NovaACELoRATrainer","pos":[1393.6297122288172,-833.3958109923814],"size":[450.53792313081203,673.0040433593749],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"tensor_dir","name":"tensor_dir","type":"STRING","widget":{"name":"tensor_dir"},"link":5},{"localized_name":"output_dir","name":"output_dir","type":"STRING","widget":{"name":"output_dir"},"link":36},{"localized_name":"checkpoint_dir","name":"checkpoint_dir","type":"STRING","widget":{"name":"checkpoint_dir"},"link":37},{"localized_name":"variant","name":"variant","type":"COMBO","widget":{"name":"variant"},"link":null},{"localized_name":"preset","name":"preset","type":"COMBO","widget":{"name":"preset"},"link":null},{"localized_name":"rank","name":"rank","type":"INT","widget":{"name":"rank"},"link":null},{"localized_name":"alpha","name":"alpha","type":"INT","widget":{"name":"alpha"},"link":null},{"localized_name":"learning_rate","name":"learning_rate","type":"FLOAT","widget":{"name":"learning_rate"},"link":null},{"localized_name":"epochs","name":"epochs","type":"INT","widget":{"name":"epochs"},"link":null},{"localized_name":"batch_size","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null},{"localized_name":"gradient_accumulation","name":"gradient_accumulation","type":"INT","widget":{"name":"gradient_accumulation"},"link":null},{"localized_name":"save_every","name":"save_every","type":"INT","widget":{"name":"save_every"},"link":null},{"localized_name":"optimizer","name":"optimizer","type":"COMBO","widget":{"name":"optimizer"},"link":null},{"localized_name":"gradient_checkpointing","name":"gradient_checkpointing","type":"COMBO","widget":{"name":"gradient_checkpointing"},"link":null},{"localized_name":"device","name":"device","type":"COMBO","widget":{"name":"device"},"link":null},{"localized_name":"precision","name":"precision","type":"COMBO","widget":{"name":"precision"},"link":null},{"localized_name":"dry_run","name":"dry_run","type":"BOOLEAN","widget":{"name":"dry_run"},"link":null},{"localized_name":"warmup_steps","name":"warmup_steps","type":"INT","widget":{"name":"warmup_steps"},"link":null},{"localized_name":"acestep_repo_path","name":"acestep_repo_path","shape":7,"type":"STRING","widget":{"name":"acestep_repo_path"},"link":38},{"localized_name":"resume_from","name":"resume_from","shape":7,"type":"STRING","widget":{"name":"resume_from"},"link":null}],"outputs":[{"localized_name":"lora_dir","name":"lora_dir","type":"STRING","links":[]},{"localized_name":"output_dir","name":"output_dir","type":"STRING","links":[]},{"localized_name":"exit_code","name":"exit_code","type":"INT","links":[]},{"localized_name":"console","name":"console","type":"STRING","links":[81]}],"properties":{"Node name for S&R":"NovaACELoRATrainer","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["","","","xl_sft","quick_test",16,32,0,10,0,2,5,"from preset","from preset","auto","bf16",true,30,"",""]},{"id":44,"type":"NovaConsole","pos":[1852.6417194632197,-832.3198683614532],"size":[755.3360914062505,1370.8115261718754],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"*","link":81},{"localized_name":"label","name":"label","shape":7,"type":"STRING","widget":{"name":"label"},"link":null},{"localized_name":"print_to_server_log","name":"print_to_server_log","shape":7,"type":"BOOLEAN","widget":{"name":"print_to_server_log"},"link":null},{"localized_name":"max_lines","name":"max_lines","shape":7,"type":"INT","widget":{"name":"max_lines"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":null}],"properties":{"Node name for S&R":"NovaConsole","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["",true,0]},{"id":40,"type":"NovaConsole","pos":[905.3071471515218,-61.023112279192],"size":[916.5462551562503,586.2392793750005],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"*","link":76},{"localized_name":"label","name":"label","shape":7,"type":"STRING","widget":{"name":"label"},"link":null},{"localized_name":"print_to_server_log","name":"print_to_server_log","shape":7,"type":"BOOLEAN","widget":{"name":"print_to_server_log"},"link":null},{"localized_name":"max_lines","name":"max_lines","shape":7,"type":"INT","widget":{"name":"max_lines"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":null}],"properties":{"Node name for S&R":"NovaConsole","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["",true,0],"color":"#222","bgcolor":"#000"},{"id":42,"type":"Note","pos":[2618.1852380421296,-833.5548528429894],"size":[987.6395511718742,1373.4807124999998],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"🎓 NOVA ACE LORA TRAINER - SETTINGS REFERENCE","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["\nEvery widget set to 0 or \"from preset\" takes its value from the preset.\n0 is not \"zero\", it is \"don't override\". That is why batch_size shows 0.\n\n📦 1. VARIANTS  (must match what Nova ACE Preprocess used)\n----------------------------------------------------------\n\nvariant    folder                   weights  size    noise schedule\n---------  -----------------------  -------  ------  ---------------------\nxl_sft     acestep-v15-xl-sft       bf16     9.3 GB  shift 1.0 / 50 steps\nxl_base    acestep-v15-xl-base      bf16     9.3 GB  shift 1.0 / 50 steps\nxl_turbo   acestep-v15-xl-turbo     bf16     9.3 GB  shift 3.0 /  8 steps\nsft        acestep-v15-sft          bf16     4.5 GB  shift 1.0 / 50 steps\nbase       acestep-v15-base         bf16     4.5 GB  shift 1.0 / 50 steps\nturbo      acestep-v15-turbo        bf16     4.5 GB  shift 3.0 /  8 steps\n\nXL is 32 layers x 2560 hidden. Non-XL is 24 x 2048 - about half the weights,\nso expect roughly half the step time and less VRAM, with a lower quality ceiling.\n\nThe noise schedule is NOT taken from the preset. Every shipped preset hardcodes\nshift 3.0 / 8 steps (turbo values); this node reads is_turbo from the\ncheckpoint's own config.json and derives the right pair. Training an SFT\ncheckpoint on a turbo schedule is the single most common silent mistake.\n\nPick the variant you will GENERATE with. A LoRA trained on xl_sft is not\ninterchangeable with one trained on xl_turbo.\n\n\n⏱️ 2. SETTINGS TIERS  -  fastest to longest\n-------------------------------------------\n\nFor a 6-track set. batch_size 1, gradient_accumulation 2 unless noted.\n\ntier          preset        rank alpha epochs  ga warmup save_every  steps  time\n------------  ------------  ---- ----- ------  -- ------ ----------  -----  -----\n1 smoke test  quick_test      16    32     10   4      2          5     20  ~2m\n2 fast draft  recommended     16    32     60   2     18         15    180  ~16m\n3 balanced    recommended     32    64    200   2     60         25    600   53m\n4 strong      recommended     64   128    400   2    120         50   1200  ~1h45\n5 maximum     high_quality   128   256    800   2    240        100   2400  ~3h30\n\nTier 3 is measured: 6 FLAC masters, 22.7 min of audio, xl_sft, bf16,\ngradient_checkpointing on, RX 9070 XT (15.9 GiB) -> 53m06s, 600 steps,\npeak 11.3 GiB VRAM, 80.1 MiB adapter, 8 checkpoints.\n\nEvery other time is that run scaled by step count (~5.3 s/step). Step time is\nset by the base model, not by rank, so rank 16 and rank 128 cost about the same\nper step - rank buys capacity, VRAM and file size, not minutes.\n\nadapter size  ~2.5 MiB per rank point   (r16 ~40 MiB, r32 80 MiB, r128 ~320 MiB)\nextra VRAM    ~+1.5 GiB going rank 32 -> 128   (estimate, not yet measured here)\n\nTier 1 is a pipeline test, not a LoRA. It proves the paths, the checkpoint and\nthe tensors are right before you commit an afternoon. Tier 3 is the one to\nstart real work from. Go to 4/5 only when tier 3 clearly underfits - the style\ndoes not come through even with the trigger word.\n\n\n🔢 3. THE STEP COUNT IS WHAT MATTERS, NOT EPOCHS\n------------------------------------------------\n\n    batches/epoch = ceil(tracks / batch_size)\n    steps/epoch   = ceil(batches/epoch / gradient_accumulation)\n    total steps   = steps/epoch x epochs\n\n6 tracks, batch_size 1, gradient_accumulation 2  ->  3 steps/epoch.\nSo 200 epochs = 600 steps. The trainer prints this before it launches - read\nthat line, it is the only number that describes the run.\n\nIf gradient_accumulation is larger than the number of batches, the accumulator\nnever fills and only the end-of-epoch flush fires. 6 tracks at ga 8 is ONE step\nper epoch, and the \"effective batch = 8\" shown by upstream is fiction.\n\nEpochs to keep ~600 total steps as the set grows (batch_size 1, ga 2):\n\n  tracks      6     12     24     48    100\n  epochs    200    100     50     25     12\n\n\n🔥 4. WARMUP\n------------\n\nwarmup_steps counts OPTIMIZER STEPS, not epochs. Every shipped preset sets it\nto 100, which on a 6-track run (600 steps) is 17% of training, and on a tier-1\nsmoke test is longer than the whole run - the LR ramps up and training stops\nbefore cosine decay ever starts.\n\nRule: warmup = 10% of total steps. Never leave it at 0 on a small dataset.\n\n\n🧠 5. VRAM PRESETS  (starting points for other machines)\n--------------------------------------------------------\n\npreset          VRAM      rank alpha  bs  ga  optimizer   offload encoder\n--------------  --------  ---- -----  --  --  ----------  ----------------\nvram_8gb        < 10 GB     16    32   1   8  adamw8bit   yes\nvram_12gb       10-16 GB    32    64   1   4  adamw8bit   yes\nvram_16gb       16-24 GB    64   128   1   4  adamw       no\nvram_24gb_plus  24 GB +    128   256   2   2  adamw       no\n\nadamw8bit needs bitsandbytes, prodigy needs prodigyopt. Both are checked before\nthe run starts. All four still carry epochs 100 and warmup_steps 100 - override\nboth using section 3.\n\ngradient_checkpointing: 40-60% less VRAM for 10-30% more time. Leave it on.\nprecision: bf16 matches the bf16 checkpoints. Do not use fp16.\ndevice: on ROCm the correct value is \"cuda\" - that is what torch calls it.\n\n\n🛠️ 6. WHEN IT DOES NOT WORK\n---------------------------\n\nStyle does not come through      raise rank first (32 -> 64), then epochs.\n                                 Raising learning_rate is the last resort.\nEverything sounds the same       overfit. Fewer epochs, or lower\n                                 learning_rate to 5e-5 and keep the epochs.\nRun ends in seconds, exit 0      upstream swallows exceptions. Check the\n                                 console for [FAIL] / Traceback, and whether\n                                 final/ was actually written.\nOut of memory                    drop a vram tier: ga up, rank down,\n                                 optimizer adamw8bit, offload encoder on.\n\nAlways run once with dry_run = \"show command only\". It does every pre-flight\ncheck and prints the exact command without starting it.\n```"],"color":"#432","bgcolor":"#653"},{"id":39,"type":"NovaACESetupCheck","pos":[39.921321659706344,-69.67274372974828],"size":[853.2747357177732,126],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"checkpoint_dir","name":"checkpoint_dir","type":"STRING","widget":{"name":"checkpoint_dir"},"link":74},{"localized_name":"variant","name":"variant","type":"COMBO","widget":{"name":"variant"},"link":null},{"localized_name":"acestep_repo_path","name":"acestep_repo_path","shape":7,"type":"STRING","widget":{"name":"acestep_repo_path"},"link":75}],"outputs":[{"localized_name":"ready","name":"ready","type":"BOOLEAN","links":null},{"localized_name":"console","name":"console","type":"STRING","links":[76]}],"properties":{"Node name for S&R":"NovaACESetupCheck","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["","xl_sft",""],"color":"#432","bgcolor":"#653"}],"links":[[3,5,0,6,0,"NOVA_FILES"],[4,6,0,4,0,"STRING"],[5,4,0,7,0,"STRING"],[28,22,5,5,0,"STRING"],[32,22,2,6,1,"STRING"],[33,22,1,4,1,"STRING"],[34,22,3,4,2,"STRING"],[35,22,4,4,7,"STRING"],[36,22,0,7,1,"STRING"],[37,22,3,7,2,"STRING"],[38,22,4,7,18,"STRING"],[74,22,3,39,0,"STRING"],[75,22,4,39,2,"STRING"],[76,39,1,40,0,"STRING"],[81,7,3,44,0,"STRING"]],"groups":[{"id":1,"title":"Nova Ace-Step 1.5 LoRA Pre-Processor And Training","bounding":