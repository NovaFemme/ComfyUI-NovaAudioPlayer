.748864043292,752.7158442767723],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"candidate_audio","name":"candidate_audio","type":"AUDIO","link":1},{"localized_name":"reference_report_json","name":"reference_report_json","type":"STRING","widget":{"name":"reference_report_json"},"link":null},{"localized_name":"tolerance_multiplier","name":"tolerance_multiplier","shape":7,"type":"FLOAT","widget":{"name":"tolerance_multiplier"},"link":null},{"localized_name":"reference_format","name":"reference_format","shape":7,"type":"COMBO","widget":{"name":"reference_format"},"link":null},{"localized_name":"save_reference_json","name":"save_reference_json","shape":7,"type":"BOOLEAN","widget":{"name":"save_reference_json"},"link":null},{"localized_name":"archive_name","name":"archive_name","shape":7,"type":"STRING","widget":{"name":"archive_name"},"link":null},{"localized_name":"report_path","name":"report_path","shape":7,"type":"STRING","widget":{"name":"report_path"},"link":null},{"localized_name":"audio_path","name":"audio_path","shape":7,"type":"STRING","widget":{"name":"audio_path"},"link":null},{"localized_name":"identity_selector","name":"identity_selector","shape":7,"type":"STRING","widget":{"name":"identity_selector"},"link":null},{"localized_name":"lookup_mode","name":"lookup_mode","shape":7,"type":"COMBO","widget":{"name":"lookup_mode"},"link":null}],"outputs":[{"localized_name":"candidate_audio","name":"candidate_audio","type":"AUDIO","links":[4]},{"localized_name":"sample_rate","name":"sample_rate","type":"SAMPLE_RATE","links":null},{"localized_name":"validation_report","name":"validation_report","type":"STRING","links":[2]},{"localized_name":"validation_json","name":"validation_json","type":"STRING","links":null},{"localized_name":"verdict","name":"verdict","type":"STRING","links":[3]},{"localized_name":"archive_audio_path","name":"archive_audio_path","type":"STRING","links":[]},{"localized_name":"archive_report_path","name":"archive_report_path","type":"STRING","links":null}],"properties":{"Node name for S&R":"NovaFinalMasterValidator","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["",1,"PCM_16",false,"","Album/High Water Sessions/Master/Reports","Album/High Water Sessions/Master/Audio","Nine Hours North","identity"]},{"id":5,"type":"Note","pos":[375.8956423418954,-12310.086507010337],"size":[1039.6630460114877,1483.6450664234053],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"🔍 NOVA AUDIO MASTER COMPARISON - VALIDATE A FILE AGAINST A MASTER","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["\nThree nodes. Load the file, read the verdict. Nothing here reads the file's name\nor its embedded tags - both can be anything.\n\n\n⚙️ SETUP\n--------\n\n* reference_report_json  (leave UNCONNECTED - that is what switches this node\n                          from archiving to looking up)\n* lookup_mode            (identity)\n* identity_selector      (release title, ISRC or catalog number; add the version\n                          when a track has more than one master:\n                          Nine Hours North Album Version)\n* report_path            (the archive folder)\n* save_reference_json    (false - this flow reads archives, it never writes one)\n\n\n🔎 ASK THE OTHER QUESTION\n-------------------------\n\nLeave identity_selector empty and set lookup_mode to content scan to ask which\narchived master a file IS. An exact PCM hash is definitive. Otherwise every\narchive is scored on duration and measurements, and you get the winner, the\nrunner-up and the margin between them. Too close to call and it refuses rather\nthan guessing.\n\n\n📋 THE VERDICTS\n---------------\n\nBIT_EXACT\nIdentical samples. The only verdict that proves nothing was altered.\n\nREPRODUCTION_MATCH\nConsistent with the master, re-encoded. It does NOT exclude a local edit: half a\nsecond spliced into a four minute track measures the same and scores 100.00.\n\nACCEPTABLE_DERIVATIVE\nMeasurements agree, format does not. A 44.1 cut of a 48k master, or a trimmed\ncopy. The drift lines say which.\n\nDRIFT_DETECTED\nSomething moved. Check whether it was the audio or the meter - comparing across\nsample rates shifts LUFS by about 0.13 on its own.\n\nVALIDATION_FAIL\nA metric is far outside tolerance.\n\n\n⚠️ REFERENCE WARNINGS\n---------------------\n\nThe archive itself is weak, usually a report made with mastering bypassed. Those\ncan show a file is unaltered, never that it matches a master."],"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,3,0,"AUDIO"],[2,3,2,2,0,"STRING"],[3,3,4,2,1,"STRING"],[4,3,0,4,0,"AUDIO"]],"groups":[{"id":1,"title":"Nova Audio Master Comparison Validation","bounding":[-1382.3210440242635,-12381.32405809126,2810.6337304045146,1572.448435678194],"color":"#444","flags":{}}],"config":{},"extra":{"ue_links":[],"ds":{"scale":0.9450100000000176,"offset":[1085.5909636089561,11786.232225417674]},"links_added_by_ue":[]},"version":0.4}