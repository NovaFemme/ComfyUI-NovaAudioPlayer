# Generated on first run by manager.ensure_files_exist() — user state, not source.
# The test suite also deletes these before paneltest/scopetest.
config/*.json

# Waveform peak sidecars written next to rendered audio.
*.peaks.json

__pycache__/
*.py[cod]

node_modules/
.DS_Store

# Scratch for code moved aside; the sandbox cannot delete, so it lands here.
.trash/
_to_delete/

# Screenshots written by the browser suites.
dev/tests/_shots/

# Replies to the research agent — hand over, then delete. Never committed.
band-shares-fixed.md
madow-context-contract.md

# Saved NamePath profiles — runtime user state, same class as config/*.json.
# They record real database paths, library folders and album names, so they are
# kept out of the package rather than published with it.
profiles/
presets/Eb minor 14 gradient_estimation beta aggressive.json
